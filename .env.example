# Configuration de compilation (Vite). Copier en .env.local pour le développement,
# ou en .env.production.local / variables d'environnement de la CI pour la production.
# `npm run build` échoue si les valeurs de production sont absentes ou non chiffrées.

# Origine de l'API Laravel, sans /api/v1 ni barre finale
VITE_API_URL=http://127.0.0.1:8000           # https://api.<domaine> en production

# Serveur WebSocket (Laravel Reverb, protocole Pusher) : mêmes valeurs que PUSHER_* côté backend
VITE_PUSHER_APP_KEY=reliance-key             # clé de production
VITE_PUSHER_HOST=127.0.0.1                   # ws.<domaine> ou l'hôte de l'API
VITE_PUSHER_PORT=6001                        # 443 derrière le proxy inverse
VITE_PUSHER_SCHEME=http                      # https en production (wss)
